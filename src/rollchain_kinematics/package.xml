<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>rollchain_kinematics</name>
  <version>0.1.0</version>
  <description>ROS 2 nodes of the rollchain robot: the state publisher (rod tensions to joint states), a rod tension publisher and a slider GUI.</description>
  <maintainer email="mmlari77@gmail.com">Mehdi Lari</maintainer>
  <license>TODO</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <depend>rclcpp</depend>
  <depend>sensor_msgs</depend>
  <depend>geometry_msgs</depend>
  <depend>rollchain_interfaces</depend>
  <depend>rollchain_model</depend>

  <exec_depend>rclpy</exec_depend>
  <exec_depend>python_qt_binding</exec_depend>

  <test_depend>ament_cmake_gtest</test_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
