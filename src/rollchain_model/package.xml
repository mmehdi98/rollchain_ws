<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>rollchain_model</name>
  <version>0.1.0</version>
  <description>Static model of the rollchain robot: a multi-section, symmetric, rod-driven rolling-joint continuum robot. Pure C++ (Eigen), no ROS dependency.</description>
  <maintainer email="mmlari77@gmail.com">Mehdi Lari</maintainer>
  <license>TODO</license>

  <buildtool_depend>ament_cmake</buildtool_depend>
  <buildtool_depend>eigen3_cmake_module</buildtool_depend>
  <buildtool_export_depend>eigen3_cmake_module</buildtool_export_depend>

  <depend>eigen</depend>

  <test_depend>ament_cmake_gtest</test_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
