<!--
  The whole robot: model, URDF, RViz and a way to set the rod tensions.
    ros2 launch rollchain_bringup rollchain.launch.xml [config:=...] [gui:=true|false] [rviz:=true|false] [reconfigure:=true|false]

  One config file goes to xacro AND to every node, so the URDF and the model always match.
    gui:=true          window with one slider per rod and a gravity checkbox (default)
    gui:=false         rod_tension_publisher instead: set tension.<rod> parameters, e.g. with rqt_reconfigure
    reconfigure:=true  rqt_reconfigure, to tune physics/solver/gravity parameters of the state publisher live
-->
<launch>
  <arg name="config" default="$(find-pkg-share rollchain_description)/config/reference_robot.yaml"
       description="robot config (YAML): geometry, rods and physics"/>
  <arg name="gui" default="true" description="slider window for the rod tensions"/>
  <arg name="rviz" default="true" description="start RViz"/>
  <arg name="reconfigure" default="false" description="start rqt_reconfigure"/>
  <arg name="max_tension" default="60.0" description="tension slider range [N]"/>

  <let name="rviz_config" value="$(find-pkg-share rollchain_description)/rviz/rollchain.rviz"/>

  <node pkg="robot_state_publisher" exec="robot_state_publisher">
    <param name="robot_description" type="str" value="$(command '$(find-pkg-prefix rollchain_description)/lib/rollchain_description/rollchain_urdf $(var config)')"/>
  </node>

  <node pkg="rollchain_kinematics" exec="rollchain_state_publisher" output="screen">
    <param from="$(var config)"/>
  </node>

  <node pkg="rollchain_kinematics" exec="tension_slider_gui" if="$(var gui)">
    <param from="$(var config)"/>
    <param name="max_tension" value="$(var max_tension)"/>
  </node>

  <node pkg="rollchain_kinematics" exec="rod_tension_publisher" unless="$(var gui)">
    <param from="$(var config)"/>
    <param name="max_tension" value="$(var max_tension)"/>
  </node>

  <node pkg="rviz2" exec="rviz2" args="-d $(var rviz_config)" if="$(var rviz)"/>
  <node pkg="rqt_reconfigure" exec="rqt_reconfigure" if="$(var reconfigure)"/>
</launch>
